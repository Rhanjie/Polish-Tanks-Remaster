.radio {
    position: absolute;
    top: 20px;
    left: 50%;
    width: 600px;
    margin-left: -300px;
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(200, 200, 180, 0.3);
    background-color: rgba(12, 14, 10, 0.85);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.radio--hidden {
    opacity: 0;
    translate: 0 -20px;
}

.radio__portrait-frame {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 36px;
    border-width: 2px;
    border-color: rgb(240, 200, 100);
    background-color: rgb(46, 50, 42);
    overflow: hidden;
    margin-right: 14px;
}

.radio__portrait {
    flex-grow: 1;
    -unity-background-scale-mode: scale-and-crop;
}

.radio__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.radio__speaker {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(240, 200, 100);
    margin-bottom: 4px;
}

.radio__text {
    font-size: 17px;
    white-space: normal;
    color: rgb(240, 236, 214);
    min-height: 44px;
}

.radio__hint {
    margin-top: 6px;
    font-size: 12px;
    -unity-text-align: middle-right;
    color: rgba(222, 218, 196, 0.6);
}

.radio__hint--hidden {
    visibility: hidden;
}
