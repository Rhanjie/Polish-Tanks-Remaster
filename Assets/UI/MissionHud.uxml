<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MissionHud.uss" />
    <ui:VisualElement name="missionHud" class="mission-hud mission-hud--hidden" picking-mode="Ignore">
        <ui:VisualElement class="mission-panel" picking-mode="Ignore">
            <ui:Label name="missionTitle" class="mission-title" picking-mode="Ignore" />
            <ui:VisualElement name="currentObjective" class="mission-objectives" picking-mode="Ignore" />
            <ui:Label name="startHint" text="Drive into the yellow circle to begin" class="mission-hint mission-hud--hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="optionalPanel" class="mission-panel mission-panel--optional mission-hud--hidden" picking-mode="Ignore">
            <ui:Label text="OPTIONAL" class="mission-title mission-title--optional" picking-mode="Ignore" />
            <ui:VisualElement name="optionalObjectives" class="mission-objectives" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="notice" class="mission-notice" picking-mode="Ignore">
            <ui:Label name="noticeCaption" class="mission-notice__caption" picking-mode="Ignore" />
            <ui:Label name="noticeText" class="mission-notice__text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
