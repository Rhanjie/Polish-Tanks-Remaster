  m_Script: {fileID: 11500000, guid: f3c5949bf21646347b625dba2c8c6247, type: 3}
  m_Name: Radio_Tutorial_Welcome
  m_EditorClassIdentifier: PolishTanks.Runtime::PolishTanks.Radio.RadioSequence
  messages:
  - speaker: {fileID: 11400000, guid: a2493e43749f7c8498b1075316e035e8, type: 2}
    text: Welcome to the training ground, recruit. W drives you forward and S backs you up. A and D turn the hull. The gun always looks where your cursor points.
  - speaker: {fileID: 11400000, guid: a2493e43749f7c8498b1075316e035e8, type: 2}
    text: Take the street ahead and drive into the blue circle. That starts your first task.
