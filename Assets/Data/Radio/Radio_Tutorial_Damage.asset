  m_Script: {fileID: 11500000, guid: f3c5949bf21646347b625dba2c8c6247, type: 3}
  m_Name: Radio_Tutorial_Damage
  m_EditorClassIdentifier: PolishTanks.Runtime::PolishTanks.Radio.RadioSequence
  messages:
  - speaker: {fileID: 11400000, guid: a2493e43749f7c8498b1075316e035e8, type: 2}
    text: 'A shell that gets through can knock out a module: the engine, a track, the gun or the turret ring. Press R and the crew gets a broken module working again, though not as good as new.'
  - speaker: {fileID: 11400000, guid: a2493e43749f7c8498b1075316e035e8, type: 2}
    text: Only the workshop ahead puts everything right. Swing by on your way.
